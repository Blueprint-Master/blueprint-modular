# À copier dans la racine du repo sur le VPS : cp deploy/app-env.example .env
# Puis renseigner les valeurs (surtout DATABASE_URL, NEXTAUTH_SECRET, NEXTAUTH_URL, Google OAuth).
# DATABASE_URL doit être une ligne réelle (sans #). Pour Prisma migrate dev en local, l'utilisateur
# PostgreSQL doit avoir CREATEDB (voir docs/DATABASE.md §5 et scripts/prisma-grant-createdb.sh).

# NextAuth (obligatoire en prod)
# NEXTAUTH_URL doit être EXACTEMENT l’URL publique de l’app (https, pas http).
NEXTAUTH_SECRET=    # openssl rand -hex 32
NEXTAUTH_URL=https://app.blueprint-modular.com

# Inscription e-mail avec preuve de possession. STARTTLS obligatoire hors relais local.
# AUTH_SMTP_URL=smtps://utilisateur:mot-de-passe@relais.exemple.fr:465
# AUTH_MAIL_FROM=Modular <inscription@exemple.fr>
# SKIP_AUTH_FOR_TEST est réservé aux environnements de développement et de test.

# OAuth (Google pour la connexion)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base de données (obligatoire) — remplacer user:password par l'utilisateur PostgreSQL réel
DATABASE_URL=postgresql://user:password@localhost:5432/blueprint_modular

# Ollama — modèles (VPS : ollama pull qwen3:8b && qwen3-embedding:4b && qwen3-vl:8b)
# AI_SERVER_URL=http://localhost:11434
# AI_MODEL=qwen3:8b
# AI_EMBEDDING_MODEL=qwen3-embedding:4b
# AI_VISION_MODEL=qwen3-vl:8b
# En production SANS Ollama : définir AI_MOCK=true pour que l'assistant IA fonctionne en mode démo (réponses simulées).
# AI_MOCK=true

# Optionnel : autres OAuth, clés IA, etc.
# APPLE_ID= ...
# ANTHROPIC_API_KEY= ...

# Service Whisper (transcription vocale — Wiki, Assistant IA)
# URL du micro-service faster-whisper (port 9000 sur le VPS)
# WHISPER_SERVICE_URL=http://localhost:9000

# Page de statut (/status) — sonde de disponibilité publique.
# Jeton partagé protégeant POST /api/status/probe (déclenché par cron, voir
# deploy/status-probe.crontab). Sans jeton, l'endpoint refuse (fail-closed) et
# aucune mesure n'est collectée. Générer : openssl rand -hex 24.
STATUS_PROBE_TOKEN=
# Cibles sondées (optionnel — défaut = URLs publiques de prod).
# STATUS_PROBE_VITRINE_URL=https://blueprint-modular.com
# STATUS_PROBE_MCP_URL=https://mcp.blueprint-modular.com/api/mcp
