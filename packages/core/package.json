{
  "name": "@blueprint-modular/core",
  "version": "0.3.5",
  "description": "Blueprint Modular — composants React pour apps de données",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/packages/core/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/packages/core/src/index.d.ts"
    },
    "./schema": {
      "import": "./dist/schema/index.js",
      "require": "./dist/schema/index.js",
      "types": "./dist/schema/index.d.ts"
    },
    "./connectors": {
      "import": "./dist/connectors/index.mjs",
      "require": "./dist/connectors/index.js",
      "types": "./dist/packages/core/src/connectors/index.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist/",
    "USAGE.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "gate:test": "vitest run gate/",
    "gate:types": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "leaflet": ">=1.9.0",
    "react-leaflet": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "leaflet": {
      "optional": true
    },
    "react-leaflet": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "highlight.js": "11.11.1",
    "idb-keyval": "6.2.5",
    "qrcode.react": "4.2.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "zod": "^4.3.6"
  }
}
