# Application
NEXTAUTH_SECRET=your_secret_here
NEXTAUTH_URL=https://app.blueprint-modular.com
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# OAuth Google (optionnel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# IA — Ollama
AI_SERVER_URL=http://localhost:11434
AI_MODEL=qwen2.5:7b
AI_TIMEOUT=120
AI_MAX_RETRIES=2
AI_MOCK=false

# IA — Anthropic (module IA / Documents). Pour le Monitor (téléprompte), saisir la clé dans l’interface 🔑, pas ici.
ANTHROPIC_API_KEY=

# Auth test (désactiver en prod)
SKIP_AUTH_FOR_TEST=false

# Sandbox IA — aperçu éphémère « Spark » (POST /api/sandbox/spark-preview).
# Flux Sketch OFF no-persist : aucune persistance/déploiement/export.
# Allowlist d'origine (séparée par des virgules). Vide = défauts intégrés
# (blueprint-modular.com + localhost). Le site Modular doit y figurer.
SANDBOX_PREVIEW_ALLOWED_ORIGINS=
# Jeton serveur optionnel pour les appels serveur-à-serveur (en-tête
# x-sandbox-preview-token). Si défini, contourne l'allowlist d'origine.
SANDBOX_PREVIEW_TOKEN=
# Nombre max de requêtes par IP et par minute (défaut 10).
SANDBOX_PREVIEW_RATE_LIMIT=10
# URL INTERNE du Maker (serveur→serveur, jamais publique) vers laquelle la
# sandbox relaie le prompt. Sur bpm-prod : http://localhost:<port_maker> (3001).
# Lire le port réel depuis l'ecosystem PM2 du Maker — ne pas hardcoder ailleurs.
MAKER_INTERNAL_URL=
# Secret partagé pour l'appel interne Maker (Authorization: Bearer). DOIT être
# identique à l'INTERNAL_API_SECRET du Maker. Jamais committé, jamais exposé au client.
INTERNAL_API_SECRET=

# Déploiement VPS — lues par deploy_blueprint_modular.{ps1,sh},
# deploy_blueprint_modular_full.ps1 et scripts/deploy-vps-remote.ps1.
# Aucune valeur réelle versionnée : renseigner localement.
VPS_HOST=
VPS_USER=
VPS_SSH_KEY=
VPS_REMOTE_PATH=/var/www/blueprint-modular
